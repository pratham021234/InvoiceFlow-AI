# ==========================================
# InvoiceFlow AI - Environment Configuration
# ==========================================

# Backend Configuration
PROJECT_NAME="InvoiceFlow AI"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-strong-random-secret-key-for-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL for Docker/Production, SQLite for local testing)
# Docker compose format:
DATABASE_URL=postgresql://invoiceflow:invoiceflow_secret@localhost:5432/invoiceflow_db
# Local SQLite fallback format:
# DATABASE_URL=sqlite:///./invoiceflow.db

# CORS & Networking
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"
FRONTEND_URL="http://localhost:3000"

# Transactional Email Provider ("mock", "smtp", "postmark", "sendgrid")
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_TLS=true
EMAIL_FROM=invoices@yourdomain.com
EMAIL_FROM_NAME="InvoiceFlow AI"

# Optional AI Assistance ("mock", "openai", "none")
AI_PROVIDER=mock
OPENAI_API_KEY=sk-your-openai-api-key-here
AI_MODEL=gpt-4o-mini

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
